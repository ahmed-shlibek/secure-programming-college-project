APP_NAME="secure-programming-college-project"
APP_ENV=development
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=secure_programming_college_project
DB_USER=root
DB_PASS=
# Path to the MySQL provider's CA certificate (ca.pem). When set, the DB
# connection uses TLS and verifies the server certificate. Leave empty for
# local dev. On Render, upload the CA as a Secret File and set this to its
# mount path, e.g. DB_SSL_CA=/etc/secrets/mysql-ca.pem
DB_SSL_CA=

# Shared secret with Cloudflare. Must match the value Cloudflare sends in the
# X-Origin-Verify header (Transform Rule). Leave empty to disable the check (local dev).
ORIGIN_SECRET=

# Cloudflare R2 (S3-compatible) — stores contact-form PDF attachments in a PRIVATE
# bucket. Create an R2 API token (Object Read & Write) in the Cloudflare dashboard.
# The endpoint is derived as https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com.
# Leave these empty in local dev to disable uploads gracefully.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=